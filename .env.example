# Copy this file to .env.local and adjust. Never commit .env.local.
# Every variable is optional: the site builds and runs without any of them.

# Public origin of the deployed site. Used for canonical URLs, Open Graph
# tags, the sitemap and robots.txt. Example: https://rajkonde.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Email address shown on the site. Leave empty to hide it.
# Note: NEXT_PUBLIC_ variables are embedded in client code and are public.
NEXT_PUBLIC_CONTACT_EMAIL=

# --- Contact form (all three are required to enable it) ---------------------
# Server-only secrets: never prefix these with NEXT_PUBLIC_. Without all three,
# the site shows plain contact links instead of the form.
# Create a key at https://resend.com/api-keys
RESEND_API_KEY=
# Where messages are delivered (your inbox).
CONTACT_TO_EMAIL=
# Sender shown by the mail provider, e.g. "Portfolio <onboarding@resend.dev>".
# Use a verified domain in production.
CONTACT_FROM_EMAIL=
# Optional: messages allowed per visitor per hour (default 5).
# CONTACT_RATE_LIMIT_PER_HOUR=5
